      "settingRebuildPath": true,
      "settingFollowRedirects": "global",
      "preRequestScript": "const CryptoJS = require('crypto-js');\nconst medidoEm = Math.floor(Date.now() / 1000);\nconst corpo = { ambienteId: 'sala-03', dispositivo: 'esp32-sala-03', temperaturaC: 33.4, umidadePct: 58, medidoEm };\nconst canonico = `${corpo.ambienteId}|${corpo.dispositivo}|${corpo.temperaturaC.toFixed(1)}|${corpo.umidadePct}|${medidoEm}`;\ncorpo.assinatura = CryptoJS.HmacSHA256(canonico, 'segredo-de-teste-sala-03').toString(CryptoJS.enc.Hex);\ninsomnia.environment.set('leitura_aceita', JSON.stringify(corpo));\ninsomnia.request.body.update({ mode: 'raw', raw: JSON.stringify(corpo) });"
