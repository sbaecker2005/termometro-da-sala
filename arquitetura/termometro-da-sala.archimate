<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Termômetro da Sala" id="id-modelo-termometro" version="5.0.0">
  <folder name="Strategy" id="id-9781f4949c864baa9eb694c1f7231972" type="strategy"/>
  <folder name="Business" id="id-37385217c9824cb19675b76d66ffd159" type="business">
    <element xsi:type="archimate:BusinessActor" name="Professor(a)" id="e-prof">
      <documentation>Usa o app: acompanha o nível atual e o previsto da sala e registra ocorrências com foto.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Turma" id="e-turma">
      <documentation>Beneficiária das ações do protocolo de calor; não opera o sistema.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Coordenação pedagógica" id="e-coord">
      <documentation>Opera o terminal: vê todas as salas, decide, registra a ação, cadastra salas e revoga sensores.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Diretoria de Ensino" id="e-diretoria">
      <documentation>Diretoria de Ensino / Seduc-SP: recebe o relatório por sala para decidir onde climatizar primeiro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Medir" id="e-medir">
      <documentation>O sensor lê a sala a cada 10 s, acende o LED da porta e envia a leitura assinada.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Prever" id="e-prever">
      <documentation>Rua prevista em 2 h somada ao delta da sala dá o nível previsto. A previsão é apoio, não decisão.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Alertar" id="e-alertar">
      <documentation>O nível atual e o previsto aparecem no app, no terminal e no painel, com a ação sugerida para o nível.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Agir" id="e-agir">
      <documentation>A coordenação aplica o protocolo de calor: água, pausa, troca de sala, adiar Educação Física ou tirar a turma.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Registrar" id="e-registrar">
      <documentation>Ação e ocorrência ficam gravadas com data e hora; o tempo entre alerta e ação vira indicador.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Ocorrência da sala" id="e-ocorrencia">
      <documentation>O que aconteceu na sala, com foto opcional da sala ou do equipamento. Pergunta o que aconteceu, nunca com quem.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Protocolo de calor (ações por nível)" id="e-protocolo">
      <documentation>Ação sugerida para cada nível do índice de calor (Frio, Normal, Atenção, Cuidado extremo, Perigo). Frio abaixo de 18 °C: amarelo piscando (500 ms); fechar janelas, agasalhar e oferecer cobertor; à noite, avisar o plantão e levar quem estiver no cômodo mais frio para outro.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Relatório por sala" id="e-relatorio">
      <documentation>Níveis, ações e minutos entre alerta e ação por sala, exportados em CSV pelo terminal para a Diretoria de Ensino.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Operador do protocolo" id="e-papel">
      <documentation>Papel de quem aplica o protocolo de calor. Hoje é assumido pela coordenação pedagógica.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Alerta do nível da sala" id="e-servico-neg">
      <documentation>Serviço que a escola passa a ter: saber o nível da sala agora e em 2 h, com a ação sugerida.</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Sala entra em Perigo" id="e-evento">
      <documentation>Leitura com índice de calor a partir de 41 °C, a faixa Perigo da NOAA.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Famílias e comunidade escolar" id="e-familias">
      <documentation>Veem o painel na TV da escola, só de leitura.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Resposta ao calor pelo protocolo" id="e-servico-agir">
      <documentation>Serviço para a turma: a ação do protocolo chega antes de alguém passar mal.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Registro e relatório por sala" id="e-servico-registro">
      <documentation>Serviço para a Diretoria de Ensino: histórico de níveis e ações de cada sala.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="App no celular do professor" id="e-bi-app">
      <documentation>Canal do professor para ver a sala e registrar ocorrência.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Terminal da coordenação" id="e-bi-terminal">
      <documentation>Canal da coordenação para ver todas as salas e registrar a ação.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="Mural na TV da escola" id="e-bi-painel">
      <documentation>Canal público de só leitura, sem fotos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessInterface" name="LED na porta da sala" id="e-bi-led">
      <documentation>Canal que não depende de rede: verde, amarelo ou vermelho na porta.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Ação registrada" id="e-bo-acao">
      <documentation>Que ação do protocolo foi tomada, em que nível e quando.</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-e5075f0e9783470fa0abbabf639ab7e2" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="API Termômetro da Sala (ASP.NET Core 8)" id="e-api">
      <documentation>Valida e grava leituras, calcula o índice e a previsão, guarda ocorrências e ações. ASP.NET Core 8 com EF Core.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Assinante MQTT (MQTTnet)" id="e-mqtt">
      <documentation>Parte da API (serviço em segundo plano com MQTTnet). Recebe as leituras do broker e aplica a mesma checagem do POST /leituras.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Modelo de ML (árvore de decisão)" id="e-modelo">
      <documentation>Árvore de decisão (profundidade 12, folha 24) que prevê o índice de calor da rua em 2 h. MAE de 0,909 °C no teste de 2025, contra 1,442 °C do baseline.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="App do professor (Expo)" id="e-app">
      <documentation>App do professor em Expo e TypeScript: salas, detalhe com previsão e ocorrência com foto.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Painel web (mural da TV)" id="e-painel">
      <documentation>Página estática no wwwroot da API: mural de só leitura para a TV da escola, sem fotos.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Terminal da coordenação (Windows Forms)" id="e-desktop">
      <documentation>Windows Forms: salas, registro de ação, cadastro de sala, revogação de sensor e CSV. Se a API cai, usa a reserva local.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Leitura assinada" id="e-leitura">
      <documentation>Tabela Leituras: sala, dispositivo, temperatura, umidade, índice, nível, medidoEm, origem e marca de suspeita.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Previsão da sala" id="e-previsao">
      <documentation>Calculada a cada consulta (rua prevista, delta e nível em 2 h). A API grava a previsão servida na tabela Previsoes, com CalculadaEm, no máximo uma por sala a cada 10 min, para comparar depois com a leitura medida.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Consulta de nível e previsão" id="e-servico-app">
      <documentation>GET /ambientes e GET /ambientes/{id}/previsao: nível atual, previsto e ação sugerida.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Rotas HTTP da API" id="e-iface">
      <documentation>Rotas REST descritas em CONTRATO.md. As de escrita da coordenação exigem o cabeçalho X-Chave-Coordenacao.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Ambiente (sala)" id="e-do-sala">
      <documentation>Tabela Ambientes: nome, tipo, andar, face ao sol e ventilador. A entidade é neutra para servir outros lugares quentes.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Dispositivo (sensor)" id="e-do-dispositivo">
      <documentation>Tabela Dispositivos: sala, segredo do HMAC, ativo e último medidoEm aceito. Revogar desliga o sensor.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Ocorrência" id="e-do-ocorrencia">
      <documentation>Tabela Ocorrencias: sala, descrição, caminho da foto e data. Nenhum campo de aluno.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Ação" id="e-do-acao">
      <documentation>Tabela Acoes: sala, nível no momento, descrição e data do registro.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Nível e ação sugerida" id="e-do-nivelacao">
      <documentation>Tabela NiveisAcao: faixa do índice de calor e a ação sugerida para cada nível. Frio abaixo de 18 °C: amarelo piscando (500 ms); fechar janelas, agasalhar e oferecer cobertor; à noite, avisar o plantão e levar quem estiver no cômodo mais frio para outro.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Recebimento de leitura assinada" id="e-as-leitura">
      <documentation>POST /leituras e assinatura MQTT: confere HMAC, ordem do medidoEm e faixa dos valores antes de gravar.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Registro de ação" id="e-as-acao">
      <documentation>GET e POST /acoes. A escrita exige a chave da coordenação.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Registro de ocorrência" id="e-as-ocorrencia">
      <documentation>POST /ocorrencias com foto opcional; a foto sai por GET /ocorrencias/{id}/foto, por id e nunca por caminho.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Cadastro de sala e revogação de sensor" id="e-as-cadastro">
      <documentation>POST /ambientes e POST /dispositivos/{id}/revogar, com a chave da coordenação.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Mapa térmico da sala" id="e-as-mapa">
      <documentation>GET /ambientes/{id}/mapa: sensores, lugares, grade de 0,5 m interpolada por IDW e precauções. Usa a última leitura de cada sensor nos últimos 15 min; sem leitura, mantém valores nulos. App e desktop consultam o mapa. PUT /ambientes/{id}/mapa exige X-Chave-Coordenacao, configura dimensões e posições e substitui lugares, sem apagar leituras.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Posições dos sensores e lugares da sala" id="e-do-posicoes">
      <documentation>Dispositivos: posX, posY e rotulo; Ambientes: larguraM e profundidadeM; Lugares: nome, coordenadas e vulneravel. Sem posição, o sensor fica no centro. O PUT valida coordenadas e dimensões; sensores omitidos mantêm posição, lugares omitidos são removidos e nomes já existentes preservam o identificador. O GET não expõe segredos dos dispositivos.</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-b876dfc877224fb8a77e3b2e33db7160" type="technology">
    <element xsi:type="archimate:Device" name="ESP32 + DHT22 + LEDs (Wokwi)" id="e-esp32">
      <documentation>Simulado no Wokwi: calcula o nível, acende o LED e publica a leitura assinada por MQTT.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Broker MQTT público" id="e-broker">
      <documentation>Broker público. O tópico é aberto de propósito, porque a confiança vem da assinatura de cada leitura.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Windows Server (VM)" id="e-servidor">
      <documentation>VM Windows Server configurada pelos scripts 01 a 09 de infra/.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="IIS" id="e-iis">
      <documentation>Publica a API e o painel, com pool sempre ligado e recuperação automática do serviço.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Active Directory (termometro.local)" id="e-ad">
      <documentation>Domínio termometro.local: usuários, grupos, GPO e auditoria.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="DNS" id="e-dns">
      <documentation>Resolve o domínio termometro.local. O Active Directory depende dele.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="SQL Server" id="e-sql">
      <documentation>Banco SalaDb: Ambientes, Dispositivos, Leituras, LeiturasRua, Previsoes, Ocorrencias, Acoes e NiveisAcao.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="inmet_a701.csv (INMET, estação A701)" id="e-inmet">
      <documentation>Dados horários públicos da estação A701 (Mirante de Santana), 2022 a 2025, em ml/dados. Treinam e testam o modelo; a API não consulta o INMET ao vivo.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="modelo.json" id="e-arquivo-modelo">
      <documentation>Árvore exportada pelo notebook (tipo arvore: nós, atributos e limites de corte). A API carrega e percorre o arquivo em C#.</documentation>
    </element>
    <element xsi:type="archimate:CommunicationNetwork" name="Internet pública" id="e-rede">
      <documentation>Internet pública entre o ESP32, o broker, a VM e os aparelhos. Só há conexões de saída a partir da VM.</documentation>
    </element>
    <element xsi:type="archimate:Device" name="Celular do professor" id="e-dev-celular">
      <documentation>Roda o app em Expo (Android ou iOS).</documentation>
    </element>
    <element xsi:type="archimate:Device" name="PC da coordenação (Windows)" id="e-dev-pc">
      <documentation>Roda o terminal em Windows Forms e guarda a reserva local.</documentation>
    </element>
    <element xsi:type="archimate:Device" name="TV da escola com navegador" id="e-dev-tv">
      <documentation>Abre o painel web em tela cheia.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="API publicada (site no IIS)" id="e-art-api">
      <documentation>Saída do dotnet publish, implantada pelo script 08-publicar-api.ps1; inclui o painel em wwwroot e o modelo.json.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="Banco SalaDb" id="e-art-banco">
      <documentation>Arquivos do banco no SQL Server, criado pelas migrações do EF Core.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="sketch.ino (firmware do ESP32)" id="e-art-firmware">
      <documentation>Firmware do Wokwi em esp32/: leitura, índice, LED, NTP, HMAC e MQTT. O mesmo sensor avisa calor no verão (escolas) e frio no inverno (dormitórios e abrigos). Frio abaixo de 18 °C: amarelo piscando (500 ms); fechar janelas, agasalhar e oferecer cobertor; à noite, avisar o plantão e levar quem estiver no cômodo mais frio para outro.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Hospedagem web (HTTP)" id="e-ts-web">
      <documentation>Serviço do IIS que publica a API e o painel.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Banco de dados relacional" id="e-ts-banco">
      <documentation>Serviço do SQL Server usado pela API via EF Core.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Mensageria MQTT" id="e-ts-mensageria">
      <documentation>Publicar e assinar o tópico das leituras; usado pelo ESP32 e pelo assinante da API.</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-89b72e2eedc94e0da8e896d4990f4be5" type="motivation">
    <element xsi:type="archimate:Driver" name="Ondas de calor" id="e-ondas">
      <documentation>Direcionador externo. Na estação A701 do INMET (Mirante de Santana) houve 21 dias com a rua a 34 °C ou mais entre 2022 e 2025, com três episódios de três dias seguidos ou mais.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Salas sem climatização" id="e-salas">
      <documentation>Direcionador externo. 67.468 das 70.346 salas da rede estadual de SP (95,91 %) não têm climatização, pela tabulação dos microdados do Censo Escolar 2024.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Ninguém mede o calor dentro da sala" id="e-semmedida">
      <documentation>Avaliação central do problema: a estação mede a rua e o alerta público fala da cidade, mas nada diz quanto a sala 3 vai esquentar às 14h.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Nenhuma aula em Perigo sem ação" id="e-meta">
      <documentation>Objetivo da arquitetura. Medido pelo indicador aulas em Perigo sem ação registrada; meta do piloto: zero em 4 semanas.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="ODS 3.d: alerta precoce de riscos à saúde" id="e-ods3">
      <documentation>Meta 3.d da ONU. O nível previsto chega 2 h antes, com a ação sugerida.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="ODS 13.1: resiliência a riscos do clima" id="e-ods13">
      <documentation>Meta 13.1 da ONU. A escola ganha um protocolo de calor e registra se ele foi cumprido.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="ODS 4.a: ambientes de ensino seguros" id="e-ods4">
      <documentation>Meta 4.a da ONU. O histórico mostra, sala por sala, quais precisam de obra primeiro.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="ODS 11.b: cidades com plano de adaptação" id="e-ods11">
      <documentation>Meta 11.b da ONU. O relatório por sala dá à Diretoria de Ensino um dado que ela não tem hoje.</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Histórico por sala para priorizar obras" id="e-historico">
      <documentation>Resultado esperado: série de níveis e ações por sala, base do relatório que prioriza a climatização.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="LED na porta funciona sem internet" id="e-rq-offline">
      <documentation>R2. O ESP32 calcula o nível no aparelho e acende o LED da porta sem depender da rede.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Prever o nível da sala em 2 h" id="e-rq-previsao">
      <documentation>R3. Rua prevista pelo modelo em 2 h somada ao delta da sala (média sala menos rua nas últimas 3 h, com ao menos 3 leituras).</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Aceitar só leitura assinada" id="e-rq-leitura">
      <documentation>R6. HMAC-SHA256 com segredo por dispositivo e ordem estrita do medidoEm: leitura forjada ou reenviada é recusada.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Nenhum dado de aluno" id="e-rq-dados">
      <documentation>R7. A unidade do sistema é a sala; nenhuma tabela tem campo de aluno e a foto é da sala, sem pessoas.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Turma sem climatização" id="e-stake">
      <documentation>Parte interessada beneficiária. Não usa o sistema e não é cadastrada. Preocupação: aula com o calor sob controle.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="A decisão é humana" id="e-principio">
      <documentation>Princípio de arquitetura: o sistema informa e registra, e quem decide a ação é a coordenação.</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="Não acionar o ar nem guardar aluno" id="e-restricao">
      <documentation>Fora do escopo: controlar ventilador ou ar-condicionado e guardar dado de aluno.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Professor(a)" id="e-stk-prof">
      <documentation>Preocupação: saber o nível da sala agora e em 2 h e o que fazer. Atendida pela visão Negócio e pelo app.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Coordenação pedagógica" id="e-stk-coord">
      <documentation>Preocupação: decidir antes de alguém passar mal, com todas as salas num lugar só. Atendida pelas visões Negócio e Aplicação.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Famílias e comunidade escolar" id="e-stk-familias">
      <documentation>Preocupação: transparência sobre o calor nas salas, sem expor alunos. Atendida pelo painel de só leitura.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Diretoria de Ensino / Seduc-SP" id="e-stk-diretoria">
      <documentation>Preocupação: saber onde climatizar primeiro, com dado por sala. Atendida pelo relatório e pela visão Implementação e migração.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="A escola só reage quando alguém passa mal" id="e-av-reacao">
      <documentation>Avaliação da coordenação: sem medida, a ação vem depois do mal-estar, e não antes.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Não há dado por sala para priorizar obras" id="e-av-semdado">
      <documentation>Avaliação da Diretoria de Ensino: a climatização é decidida sem saber quais salas esquentam mais.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Comunidade vê o nível das salas" id="e-goal-transparencia">
      <documentation>Objetivo das famílias: o mural mostra o nível de cada sala, sem fotos e sem dado de aluno.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="A sala é a unidade, não o aluno" id="e-pr-sala">
      <documentation>Dado que não existe não vaza. Implica ocorrência por sala, foto sem pessoas e nenhum cadastro de aluno.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Nunca inventar dado" id="e-pr-dado">
      <documentation>Sem leitura recente, a tela diz isso e mostra só a previsão da rua. Implica marcar a demonstração e a leitura suspeita.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="A porta funciona sem rede" id="e-pr-porta">
      <documentation>O alerta mais próximo da turma não pode depender da internet. Implica calcular o nível no ESP32.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Confiança pela assinatura, não pelo canal" id="e-pr-assinatura">
      <documentation>O tópico MQTT é público; vale só a leitura assinada. Implica segredo por dispositivo, revogável.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Medir temperatura e umidade em cada sala" id="e-rq-medir">
      <documentation>R1. ESP32 com DHT22 na porta de cada sala.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Mostrar nível, previsão e ação sugerida" id="e-rq-mostrar">
      <documentation>R4. App, terminal e painel mostram o mesmo nível calculado pela API.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Registrar ação e ocorrência com foto" id="e-rq-registro">
      <documentation>R5. Terminal registra a ação; app registra a ocorrência com foto sem EXIF.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Sem leitura recente, não inventar o nível" id="e-rq-semdado">
      <documentation>R8. A previsão sem leitura válida da sala responde sem-dados-para-prever em vez de supor um valor.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Recuperar sozinho de falha do serviço" id="e-rq-recuperar">
      <documentation>R9. Pool sempre ligado e recuperação do serviço no IIS; o teste de falha está em infra/TESTE-DE-FALHA.md.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Frio no inverno em dormitórios e abrigos" id="e-frio-inverno">
      <documentation>O mesmo sensor avisa calor no verão (escolas) e frio no inverno (dormitórios e abrigos). O frio nesses ambientes também exige aviso e ação.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Alertar frio abaixo de 18 °C" id="e-rq-frio">
      <documentation>O nível frio abaixo de 18 °C deve aparecer com a ação sugerida e LED amarelo piscando (500 ms). Ação: fechar janelas, agasalhar e oferecer cobertor; à noite, avisar o plantão e levar quem estiver no cômodo mais frio para outro.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Indicar precauções no mapa térmico" id="e-rq-precaucoes">
      <documentation>Lugar vulnerável em frio, cuidado ou perigo recebe indicação de troca para um lugar mais próximo da faixa normal do índice [18, 27), priorizando faixa normal, distância à faixa, proximidade física e nome. Sem destino melhor, informa a ausência; não garante disponibilidade. Diferença de temperatura entre sensores extremos ≥4 °C gera aviso de ambiente desigual, com rótulos e temperaturas, para verificar janela, sol e corrente de ar. Não substitui avaliação presencial.</documentation>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-763747d8d2c1425a9de0f774eccfdcaf" type="implementation_migration">
    <element xsi:type="archimate:Plateau" name="Escola hoje: sem medição na sala" id="e-pl-hoje">
      <documentation>Situação atual: a escola sabe a temperatura da rua e reage quando alguém passa mal.</documentation>
    </element>
    <element xsi:type="archimate:Plateau" name="Protótipo desta versão (Wokwi e VM)" id="e-pl-prototipo">
      <documentation>Arquitetura implementada neste repositório: sensor simulado, API, app, terminal, painel e Windows Server.</documentation>
    </element>
    <element xsi:type="archimate:Plateau" name="Piloto em uma escola" id="e-pl-piloto">
      <documentation>Quatro semanas com sensor físico nas salas sem climatização e as metas da seção 7.1.</documentation>
    </element>
    <element xsi:type="archimate:Plateau" name="Mais de uma escola" id="e-pl-escolas">
      <documentation>Mesma solução em várias escolas, com infraestrutura própria.</documentation>
    </element>
    <element xsi:type="archimate:Plateau" name="Rede de ensino" id="e-pl-rede">
      <documentation>Relatório consolidado para a Diretoria de Ensino decidir onde climatizar primeiro.</documentation>
    </element>
    <element xsi:type="archimate:Gap" name="Lacuna: medir a sala e registrar a ação" id="e-gap-medicao">
      <documentation>Entre a escola de hoje e o protótipo: medição por sala, previsão, protocolo e registro.</documentation>
    </element>
    <element xsi:type="archimate:Gap" name="Lacuna: dado real de campo" id="e-gap-campo">
      <documentation>Entre o protótipo e o piloto: sensor físico, delta real de cada sala e segredo na memória do ESP32.</documentation>
    </element>
    <element xsi:type="archimate:WorkPackage" name="Pacote do piloto" id="e-wp-piloto">
      <documentation>Termo-higrômetro por uma semana para medir o delta real, sensor físico e segredo gravado na memória do ESP32.</documentation>
    </element>
    <element xsi:type="archimate:WorkPackage" name="Pacote de expansão" id="e-wp-escolas">
      <documentation>Broker próprio com usuário, senha e TLS, busca do INMET ao vivo, notificação no app e login do terminal com o AD.</documentation>
    </element>
    <element xsi:type="archimate:WorkPackage" name="Pacote da rede de ensino" id="e-wp-rede">
      <documentation>Relatório consolidado, novo treino anual do modelo e modelo por sala depois de haver histórico real.</documentation>
    </element>
    <element xsi:type="archimate:Gap" name="Lacuna: infraestrutura própria e segura" id="e-gap-infra">
      <documentation>Entre o piloto e várias escolas: broker próprio com usuário, senha e TLS, busca do INMET ao vivo, notificação no app e login do terminal com o AD.</documentation>
    </element>
    <element xsi:type="archimate:Gap" name="Lacuna: visão consolidada da rede" id="e-gap-rede">
      <documentation>Entre várias escolas e a rede de ensino: relatório consolidado para a Diretoria de Ensino, novo treino anual do modelo e modelo por sala.</documentation>
    </element>
    <element xsi:type="archimate:WorkPackage" name="Construção do protótipo" id="e-wp-prototipo">
      <documentation>O que este repositório entrega: ESP32 simulado no Wokwi, API, modelo, app, terminal, painel e Windows Server (seção 5).</documentation>
    </element>
  </folder>
