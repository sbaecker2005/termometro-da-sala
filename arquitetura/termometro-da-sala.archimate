  <folder name="Motivation" id="id-537c9d8878f449beae763d550a060e20" type="motivation">
    <element xsi:type="archimate:Driver" name="Ondas de calor" id="e-ondas"/>
    <element xsi:type="archimate:Driver" name="Salas sem climatização" id="e-salas"/>
    <element xsi:type="archimate:Assessment" name="Ninguém mede o calor dentro da sala" id="e-semmedida"/>
    <element xsi:type="archimate:Goal" name="Nenhuma aula em Perigo sem ação" id="e-meta"/>
    <element xsi:type="archimate:Goal" name="ODS 3.d: alerta precoce de riscos à saúde" id="e-ods3"/>
    <element xsi:type="archimate:Goal" name="ODS 13.1: resiliência a riscos do clima" id="e-ods13"/>
    <element xsi:type="archimate:Goal" name="ODS 4.a: ambientes de ensino seguros" id="e-ods4"/>
    <element xsi:type="archimate:Goal" name="ODS 11.b: cidades com plano de adaptação" id="e-ods11"/>
    <element xsi:type="archimate:Outcome" name="Histórico por sala para priorizar obras" id="e-historico"/>
    <element xsi:type="archimate:Requirement" name="LED na porta funciona sem internet" id="e-rq-offline"/>
    <element xsi:type="archimate:Requirement" name="Prever o nível da sala em 2 h" id="e-rq-previsao"/>
    <element xsi:type="archimate:Requirement" name="Aceitar só leitura assinada" id="e-rq-leitura"/>
    <element xsi:type="archimate:Requirement" name="Nenhum dado de aluno" id="e-rq-dados"/>
    <element xsi:type="archimate:Stakeholder" name="Turma sem climatização" id="e-stake"/>
    <element xsi:type="archimate:Principle" name="A decisão é humana" id="e-principio"/>
    <element xsi:type="archimate:Constraint" name="Não acionar o ar nem guardar aluno" id="e-restricao"/>
  </folder>
