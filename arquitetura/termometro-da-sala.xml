<?xml version="1.0" encoding="UTF-8"?>
<model xmlns="http://www.opengroup.org/xsd/archimate/3.0/"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd"
       identifier="id-modelo-termometro" version="1.0">
  <name xml:lang="pt">Termômetro da Sala</name>
  <documentation xml:lang="pt">Arquitetura de Soluções da CitizenTech Termômetro da Sala: camadas de motivação, negócio, aplicação e tecnologia.</documentation>

  <elements>
    <!-- Motivação -->
    <element identifier="e-ondas" xsi:type="Driver"><name xml:lang="pt">Ondas de calor</name></element>
    <element identifier="e-salas" xsi:type="Driver"><name xml:lang="pt">Salas sem climatização</name></element>
    <element identifier="e-semmedida" xsi:type="Assessment"><name xml:lang="pt">Ninguém mede o calor dentro da sala</name></element>
    <element identifier="e-meta" xsi:type="Goal"><name xml:lang="pt">Nenhuma aula em Perigo sem ação</name></element>
    <element identifier="e-ods3" xsi:type="Goal"><name xml:lang="pt">ODS 3.d: alerta precoce de riscos à saúde</name></element>
    <element identifier="e-ods13" xsi:type="Goal"><name xml:lang="pt">ODS 13.1: resiliência a riscos do clima</name></element>
    <element identifier="e-ods4" xsi:type="Goal"><name xml:lang="pt">ODS 4.a: ambientes de ensino seguros</name></element>
    <element identifier="e-ods11" xsi:type="Goal"><name xml:lang="pt">ODS 11.b: cidades com plano de adaptação</name></element>
    <element identifier="e-historico" xsi:type="Outcome"><name xml:lang="pt">Histórico por sala para priorizar obras</name></element>
    <element identifier="e-rq-offline" xsi:type="Requirement"><name xml:lang="pt">LED na porta funciona sem internet</name></element>
    <element identifier="e-rq-previsao" xsi:type="Requirement"><name xml:lang="pt">Prever o nível da sala em 2 h</name></element>
    <element identifier="e-rq-leitura" xsi:type="Requirement"><name xml:lang="pt">Aceitar só leitura assinada</name></element>
    <element identifier="e-rq-dados" xsi:type="Requirement"><name xml:lang="pt">Nenhum dado de aluno</name></element>
    <element identifier="e-stake" xsi:type="Stakeholder"><name xml:lang="pt">Turma sem climatização</name></element>
    <element identifier="e-principio" xsi:type="Principle"><name xml:lang="pt">A decisão é humana</name></element>
    <element identifier="e-restricao" xsi:type="Constraint"><name xml:lang="pt">Não acionar o ar nem guardar aluno</name></element>

    <!-- Negócio -->
    <element identifier="e-prof" xsi:type="BusinessActor"><name xml:lang="pt">Professor(a)</name></element>
    <element identifier="e-turma" xsi:type="BusinessActor"><name xml:lang="pt">Turma</name></element>
    <element identifier="e-coord" xsi:type="BusinessActor"><name xml:lang="pt">Coordenação pedagógica</name></element>
    <element identifier="e-diretoria" xsi:type="BusinessActor"><name xml:lang="pt">Diretoria de Ensino</name></element>
    <element identifier="e-medir" xsi:type="BusinessProcess"><name xml:lang="pt">Medir</name></element>
    <element identifier="e-prever" xsi:type="BusinessProcess"><name xml:lang="pt">Prever</name></element>
    <element identifier="e-alertar" xsi:type="BusinessProcess"><name xml:lang="pt">Alertar</name></element>
    <element identifier="e-agir" xsi:type="BusinessProcess"><name xml:lang="pt">Agir</name></element>
    <element identifier="e-registrar" xsi:type="BusinessProcess"><name xml:lang="pt">Registrar</name></element>
    <element identifier="e-ocorrencia" xsi:type="BusinessObject"><name xml:lang="pt">Ocorrência da sala</name></element>
    <element identifier="e-protocolo" xsi:type="BusinessObject"><name xml:lang="pt">Protocolo de calor (ações por nível)</name></element>
    <element identifier="e-relatorio" xsi:type="BusinessObject"><name xml:lang="pt">Relatório por sala</name></element>
    <element identifier="e-papel" xsi:type="BusinessRole"><name xml:lang="pt">Operador do protocolo</name></element>
    <element identifier="e-servico-neg" xsi:type="BusinessService"><name xml:lang="pt">Alerta do nível da sala</name></element>
    <element identifier="e-evento" xsi:type="BusinessEvent"><name xml:lang="pt">Sala entra em Perigo</name></element>

    <!-- Aplicação -->
    <element identifier="e-api" xsi:type="ApplicationComponent"><name xml:lang="pt">API Termômetro da Sala (ASP.NET Core 8)</name></element>
    <element identifier="e-mqtt" xsi:type="ApplicationComponent"><name xml:lang="pt">Assinante MQTT (MQTTnet)</name></element>
    <element identifier="e-modelo" xsi:type="ApplicationComponent"><name xml:lang="pt">Modelo de ML (árvore de decisão)</name></element>
    <element identifier="e-app" xsi:type="ApplicationComponent"><name xml:lang="pt">App do professor (Expo)</name></element>
    <element identifier="e-painel" xsi:type="ApplicationComponent"><name xml:lang="pt">Painel web (mural da TV)</name></element>
    <element identifier="e-desktop" xsi:type="ApplicationComponent"><name xml:lang="pt">Terminal da coordenação (Windows Forms)</name></element>
    <element identifier="e-leitura" xsi:type="DataObject"><name xml:lang="pt">Leitura assinada</name></element>
    <element identifier="e-previsao" xsi:type="DataObject"><name xml:lang="pt">Previsão da sala</name></element>
    <element identifier="e-servico-app" xsi:type="ApplicationService"><name xml:lang="pt">Consulta de nível e previsão</name></element>
    <element identifier="e-iface" xsi:type="ApplicationInterface"><name xml:lang="pt">Rotas HTTP da API</name></element>

    <!-- Tecnologia -->
    <element identifier="e-esp32" xsi:type="Device"><name xml:lang="pt">ESP32 + DHT22 + LEDs (Wokwi)</name></element>
    <element identifier="e-broker" xsi:type="SystemSoftware"><name xml:lang="pt">Broker MQTT público</name></element>
    <element identifier="e-servidor" xsi:type="Node"><name xml:lang="pt">Windows Server (VM)</name></element>
    <element identifier="e-iis" xsi:type="SystemSoftware"><name xml:lang="pt">IIS</name></element>
    <element identifier="e-ad" xsi:type="SystemSoftware"><name xml:lang="pt">Active Directory (termometro.local)</name></element>
    <element identifier="e-dns" xsi:type="SystemSoftware"><name xml:lang="pt">DNS</name></element>
    <element identifier="e-sql" xsi:type="SystemSoftware"><name xml:lang="pt">SQL Server</name></element>
    <element identifier="e-inmet" xsi:type="TechnologyService"><name xml:lang="pt">Dados horários do INMET (A701)</name></element>
    <element identifier="e-arquivo-modelo" xsi:type="Artifact"><name xml:lang="pt">modelo.json</name></element>
    <element identifier="e-rede" xsi:type="CommunicationNetwork"><name xml:lang="pt">Internet pública</name></element>
  </elements>

