      SELECT "a"."Id", "a"."Andar", "a"."FaceSol", "a"."LarguraM", "a"."Nome", "a"."ProfundidadeM", "a"."TemVentilador", "a"."Tipo", (&#xD;
          SELECT "d"."Id"&#xD;
          FROM "Dispositivos" AS "d"&#xD;
          WHERE "d"."AmbienteId" = "a"."Id"&#xD;
          ORDER BY "d"."Id"&#xD;
          LIMIT 1), COALESCE((&#xD;
          SELECT NOT ("d0"."Ativo")&#xD;
          FROM "Dispositivos" AS "d0"&#xD;
          WHERE "d0"."AmbienteId" = "a"."Id"&#xD;
          ORDER BY "d0"."Id"&#xD;
          LIMIT 1), 0), "t0"."Id", "t0"."AmbienteId", "t0"."DispositivoId", "t0"."IndiceCalor", "t0"."MedidoEm", "t0"."Nivel", "t0"."Origem", "t0"."Suspeita", "t0"."TemperaturaC", "t0"."UmidadePct"&#xD;
      FROM "Ambientes" AS "a"&#xD;
      LEFT JOIN (&#xD;
          SELECT "t"."Id", "t"."AmbienteId", "t"."DispositivoId", "t"."IndiceCalor", "t"."MedidoEm", "t"."Nivel", "t"."Origem", "t"."Suspeita", "t"."TemperaturaC", "t"."UmidadePct"&#xD;
          FROM (&#xD;
              SELECT "l"."Id", "l"."AmbienteId", "l"."DispositivoId", "l"."IndiceCalor", "l"."MedidoEm", "l"."Nivel", "l"."Origem", "l"."Suspeita", "l"."TemperaturaC", "l"."UmidadePct", ROW_NUMBER() OVER(PARTITION BY "l"."AmbienteId" ORDER BY "l"."MedidoEm" DESC, "l"."Id" DESC) AS "row"&#xD;
              FROM "Leituras" AS "l"&#xD;
          ) AS "t"&#xD;
          WHERE "t"."row" &lt;= 1&#xD;
      ) AS "t0" ON "a"."Id" = "t0"."AmbienteId"&#xD;
      ORDER BY "a"."Id"&#xD;
